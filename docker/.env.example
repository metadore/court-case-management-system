# ─── Server ──────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=production
LOG_LEVEL=info

# ─── Database ────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/tpt_court

# ─── JWT ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production

# ─── CORS ────────────────────────────────────────────────────────────────
CORS_ORIGIN=http://localhost:3000

# ─── Stripe ──────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── Web ─────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxx

# ─── File Uploads (local fallback) ────────────────────────────────────────
UPLOADS_DIR=./uploads

# ─── S3-Compatible Object Storage ───────────────────────────────────────
# Uncomment and fill in to use Wasabi, Backblaze B2, AWS S3, or MinIO.
# When configured, all document uploads go directly to S3-compatible storage.
# When commented out, files are stored locally in UPLOADS_DIR.
#
# STORAGE_ENDPOINT=https://s3.wasabisys.com
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET=tpt-court-documents
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key
# STORAGE_FORCE_PATH_STYLE=false
#
# For local MinIO (in docker-compose):
# STORAGE_ENDPOINT=http://minio:9000
# STORAGE_BUCKET=tpt-court-documents
# STORAGE_ACCESS_KEY=minioadmin
# STORAGE_SECRET_KEY=minioadmin
# STORAGE_FORCE_PATH_STYLE=true

# ─── Off-Site Backups (S3-compatible: Wasabi, Backblaze B2, AWS S3) ─────
# Uncomment and fill in to enable automated backups to S3-compatible storage.
# BACKUP_ENABLED=false
# BACKUP_S3_ENDPOINT=https://s3.wasabisys.com
# BACKUP_S3_REGION=us-east-1
# BACKUP_S3_BUCKET=tpt-court-backups
# BACKUP_S3_ACCESS_KEY=your-access-key
# BACKUP_S3_SECRET_KEY=your-secret-key
# BACKUP_SCHEDULE=0 3 * * *
# BACKUP_RETENTION_DAYS=30
# BACKUP_ENCRYPTION_KEY=        # openssl rand -base64 32 (optional, encrypts backups)