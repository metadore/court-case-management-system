# TPT Court — Desktop (Electron) environment example
#
# Electron process can read environment variables at startup.
# Web pages use NEXT_PUBLIC_* vars (also reflected in apps/web).

# API base URL for the backend (Fastify)
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# Socket.io backend URL
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# JWT signing secret (used by apps/api)
JWT_SECRET=change-me-in-production

# Stripe secret (used by apps/api)
STRIPE_SECRET_KEY=sk_test_placeholder
