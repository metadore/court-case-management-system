# ── Database ────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tpt_court"

# ── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-in-production"

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
CORS_ORIGIN="http://localhost:3000"

# ── File Storage (local defaults; configure S3 for production) ──────────────
UPLOADS_DIR="./uploads"
STORAGE_ENDPOINT=""
STORAGE_REGION="us-east-1"
STORAGE_BUCKET="tpt-court-documents"
STORAGE_ACCESS_KEY=""
STORAGE_SECRET_KEY=""
STORAGE_FORCE_PATH_STYLE="false"

# ── Stripe Payments ────────────────────────────────────────────────────────
STRIPE_SECRET_KEY="sk_test_placeholder"
STRIPE_WEBHOOK_SECRET="whsec_placeholder"

# ── Email (SMTP) ──────────────────────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="noreply@tpt-court.local"
SMTP_FROM_NAME="TPT Court System"

# ── Email (Resend) ────────────────────────────────────────────────────────
# If set, takes priority over SMTP_* config above
RESEND_API_KEY=""

# ── SMS (Twilio) ───────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# ── E-Signature ────────────────────────────────────────────────────────────
SIGNING_SECRET="change-me-in-production-signing-secret"

# ── AI Case Summarization ──────────────────────────────────────────────────
# Provider: "anthropic" (default) or "local" (Ollama-compatible)
AI_PROVIDER="anthropic"
ANTHROPIC_API_KEY=""
# Used only when AI_PROVIDER=local
LOCAL_AI_URL="http://localhost:11434"
LOCAL_AI_MODEL="llama3"

# ── Speech-to-Text (STT) Transcription ─────────────────────────────────────
# Provider: "whisper" (default - OpenAI Whisper API) or "local" (Ollama-compatible)
STT_PROVIDER="whisper"
# OpenAI API key for Whisper (required when STT_PROVIDER=whisper)
WHISPER_API_KEY=""
# Used only when STT_PROVIDER=local
LOCAL_STT_URL="http://localhost:11434"
LOCAL_STT_MODEL="whisper"

# ── App / 2FA ──────────────────────────────────────────────────────────────
APP_NAME="TPT Court"
WEB_ORIGIN="http://localhost:3000"
HEARING_REMINDER_DAYS="2"
